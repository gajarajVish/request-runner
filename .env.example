# Copy to .env (repo root or backend/). Every variable is optional in development.

# --- app
APP_ENV=development                 # production: real login only, no dev routes/demo clock, strict checks
APP_NAME=RequestRunner
APP_BASE_URL=http://localhost:5173  # public URL used in upload links (https:// required in production)
SESSION_SECRET=                     # production: random, >= 32 chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
DATA_DIR=                           # SQLite db, file blobs, sent-mail copies; default ./var
WORKSPACE_TIMEZONE=America/New_York
SEED_USERS=                         # "Name|email|password;Name|email|password" (production seeds nothing without it)

# --- LLM
LLM_PROVIDER=anthropic              # anthropic | fake (offline: deterministic stub, no API calls)
ANTHROPIC_API_KEY=
LLM_STRONG_MODEL=claude-opus-5      # scoping and evidence checking
LLM_FAST_MODEL=claude-haiku-4-5     # reply classification
LLM_STRONG_EFFORT=high
LLM_SERVER_FALLBACKS=true           # server-side refusal fallback (auto-disabled if the API rejects it)

# --- email
EMAIL_PROVIDER=file                 # file (writes .eml to DATA_DIR/sent-mail) | postmark | sendgrid
EMAIL_FROM_ADDRESS=requests@mail.example.com
EMAIL_INBOUND_DOMAIN=in.example.com # Reply-To: req+<token>@<this>
EMAIL_INBOUND_BASIC_AUTH=           # "user:password" expected on inbound webhooks (required in production)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
SENDGRID_API_KEY=

# --- policy (defaults shown)
MAX_AUTO_CONTACTS=3
REMINDER_DAYS_BEFORE_DUE=2
OVERDUE_NOTICE_DAYS_AFTER_DUE=1
ESCALATION_BUSINESS_DAYS_AFTER_OVERDUE=2
FOLLOWUP_DEBOUNCE_SECONDS=120
PROVIDER_MIN_GAP_SECONDS=600
UPLOAD_TOKEN_MIN_DAYS=14
UPLOAD_TOKEN_GRACE_DAYS=7
