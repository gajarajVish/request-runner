# Copy to .env (repo root or backend/). Every variable is optional in development.
# An empty value must have nothing after the "=": a trailing "# comment" there is read as the value.

# --- app
APP_ENV=development                 # production: real login only, no dev routes/demo clock, strict checks
APP_NAME=RequestRunner
APP_BASE_URL=http://localhost:5173  # public URL used in upload links (https:// required in production)
# production: random, >= 32 chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# SQLite db, file blobs, sent-mail copies; default ./var
DATA_DIR=
WORKSPACE_TIMEZONE=America/New_York
# "Name|email|password;Name|email|password" (production seeds nothing without it)
SEED_USERS=
SIGNUP_ENABLED=true                 # "Create an account" on the sign-in page; each account gets its own workspace
# set to require an invite code for sign-up (recommended on a public deployment)
SIGNUP_CODE=

# --- LLM
LLM_PROVIDER=anthropic              # anthropic | openai | fake (offline: deterministic stub, no API calls)
ANTHROPIC_API_KEY=
LLM_STRONG_MODEL=claude-opus-5-5    # scoping and evidence checking
LLM_FAST_MODEL=claude-haiku-4-5     # reply classification
LLM_STRONG_EFFORT=high
LLM_SERVER_FALLBACKS=true           # server-side refusal fallback (auto-disabled if the API rejects it)
# LLM_PROVIDER=openai (production on Fly uses this)
OPENAI_API_KEY=
OPENAI_STRONG_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium
LLM_MAX_RETRIES=1                   # each retry resends the full input
LLM_DAILY_TOKEN_BUDGET=5000000      # input+output tokens per UTC day; calls fail after this (0 = no cap)

# --- email
EMAIL_PROVIDER=file                 # file (writes .eml to DATA_DIR/sent-mail) | gmail | postmark | sendgrid
# gmail: send from this account and read replies from its inbox
GMAIL_ADDRESS=
# gmail: an app password (needs 2-step verification), not your normal password
GMAIL_APP_PASSWORD=
EMAIL_FROM_ADDRESS=requests@mail.example.com
EMAIL_INBOUND_DOMAIN=in.example.com # Reply-To: req+<token>@<this>
# "user:password" expected on inbound webhooks (required in production)
EMAIL_INBOUND_BASIC_AUTH=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
SENDGRID_API_KEY=

# --- policy (defaults shown)
MAX_AUTO_CONTACTS=3
REMINDER_DAYS_BEFORE_DUE=2
OVERDUE_NOTICE_DAYS_AFTER_DUE=1
ESCALATION_BUSINESS_DAYS_AFTER_OVERDUE=2
FOLLOWUP_DEBOUNCE_SECONDS=120
PROVIDER_MIN_GAP_SECONDS=600
UPLOAD_TOKEN_MIN_DAYS=14
UPLOAD_TOKEN_GRACE_DAYS=7
MAX_CHECKS_PER_REQUEST_PER_DAY=20   # each check resends all of the request's evidence
MAX_IMPORT_ROWS=300                 # each new/changed row is one scoping call
CHAT_MESSAGES_PER_10_MIN=20         # per user
