# Copy to .env and fill in. Final variable set depends on the stack/provider
# chosen in docs/DESIGN_DECISIONS.md.

APP_BASE_URL=http://localhost:8000      # public URL used in upload links (tunnel URL when testing inbound)
APP_NAME=RequestRunner

# LLM
ANTHROPIC_API_KEY=

# Outbound / inbound email
EMAIL_PROVIDER=                         # e.g. postmark | mailgun | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=requests@mail.example.com
EMAIL_INBOUND_DOMAIN=in.example.com     # Reply-To: req+<token>@<this>
EMAIL_INBOUND_WEBHOOK_SECRET=

# Upload links
UPLOAD_LINK_SECRET=
UPLOAD_LINK_TTL_DAYS=14
